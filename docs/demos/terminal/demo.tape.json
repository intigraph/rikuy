        "No graph connection"
      ]
    },
    {
      "tool": "node",
      "args": [
        "docs/demos/terminal/inspect-demo.mjs",
        "reject"
      ],
      "hold": 7,
      "requires": [
        "Brief identity UNKNOWN"
      ]
    }
  ]
